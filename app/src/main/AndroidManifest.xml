<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClassQRoom"
        tools:ignore="LockedOrientationActivity"
        tools:targetApi="31">
        <activity
            android:name=".main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".main.RegisterActivity"
            android:exported="true"/>
        <activity
            android:name=".main.LoginActivity"
            android:exported="true"/>
        <activity
            android:name=".main.ForgotPasswordActivity"
            android:exported="true"/>
        <activity
            android:name=".main.HomeActivity"
            android:exported="true"/>
        <activity
            android:name=".student.QRCodeScannerActivity"
            android:exported="true"/>
        <activity
            android:name=".lecturer.QRCodeCreatorActivity"
            android:exported="true"/>
        <activity
            android:name=".admin.FacultiesActivity"
            android:exported="true"/>
        <activity
            android:name=".admin.AddFacultyActivity"
            android:exported="true"/>
        <activity
            android:name=".admin.DepartmentsActivity"
            android:exported="true"/>
        <activity
            android:name=".admin.AddDepartmentActivity"
            android:exported="true"/>
        <activity
            android:name=".admin.LecturesActivity"
            android:exported="true"/>
        <activity
            android:name=".admin.AddLectureActivity"
            android:exported="true"/>
        <activity
            android:name=".admin.LecturersActivity"
            android:exported="true"/>
        <activity
            android:name=".admin.AddLecturerActivity"
            android:exported="true"/>
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation"
            tools:ignore="DiscouragedApi" />
        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>
</manifest>