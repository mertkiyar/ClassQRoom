<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="50dp">

    <TextView
        android:id="@+id/tfFacultyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:paddingVertical="20dp"
        android:text="@string/addnewfaculty"
        android:textSize="24sp"
        android:textStyle="normal"
        android:fontFamily="@font/urbanist"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tfFacultyName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="100dp"
        android:layout_below="@id/tfFacultyText">

        <EditText
            android:id="@+id/edtFacultyName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/facultyname"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxWidth="400dp"
            android:maxLength="48"
            tools:ignore="TextContrastCheck,VisualLintTextFieldSize" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:layout_below="@id/tfFacultyName">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="50dp"
            android:text="@string/cancel"
            tools:ignore="ButtonStyle" />
        <Button
            android:id="@+id/btnAddFaculty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/addnew"
            android:onClick="onClickAddFaculty"
            tools:ignore="ButtonStyle" />
    </LinearLayout>
</RelativeLayout>